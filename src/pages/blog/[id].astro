---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const sorted = posts.sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
  );
  return sorted.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      prev: sorted[i - 1],
      next: sorted[i + 1],
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const dateFmt = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <header class="post-header">
      <div class="container">
        <h1 class="post-title">{post.data.title}</h1>
        <div class="post-meta mono">
          <time datetime={post.data.pubDate.toISOString()}>
            {dateFmt.format(post.data.pubDate)}
          </time>
          {post.data.updatedDate && (
            <span>
              · 更新于 <time datetime={post.data.updatedDate.toISOString()}>{dateFmt.format(post.data.updatedDate)}</time>
            </span>
          )}
          {post.data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <div class="post-rule" aria-hidden="true"></div>
      </div>
    </header>

    <div class="container prose-wrap">
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="container post-nav" aria-label="文章导航">
      {prev ? (
        <a href={`/blog/${prev.id}/`} class="nav-item">
          <span class="mono dir">← 上一篇</span>
          <span class="nav-title">{prev.data.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/blog/${next.id}/`} class="nav-item nav-next">
          <span class="mono dir">下一篇 →</span>
          <span class="nav-title">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .post-header {
    padding-block: clamp(2rem, 5vw, 3rem) 0;
  }
  .post-title {
    font-size: clamp(1.75rem, 4.5vw, 3rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1rem;
    color: var(--ink-soft);
  }
  .tag {
    background: var(--ink);
    color: var(--bg);
    padding: 0.15rem 0.5rem;
  }
  .post-rule {
    height: 0;
    margin-top: 1.25rem;
    border-top: var(--rule);
  }
  .prose-wrap {
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
  }
  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }
  .nav-item {
    border: var(--rule);
    padding: 0.6rem 0.9rem;
    text-decoration: none;
    max-width: 20rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .nav-item:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .nav-next {
    margin-left: auto;
    text-align: right;
  }
  .dir {
    color: var(--ink-soft);
  }
  .nav-item:hover .dir {
    color: var(--bg);
  }
  .nav-title {
    font-weight: 500;
  }

  /* ---- Prose ---- */
  .prose {
    max-width: var(--measure);
    line-height: 1.75;
    font-size: 1rem;
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    font-weight: 500;
    margin: 2rem 0 0.75rem;
    padding-left: 0.75rem;
    border-left: 5px solid var(--ink);
    line-height: 1.3;
  }
  .prose :global(h3) {
    font-size: 1.15rem;
    font-weight: 500;
    margin: 1.5rem 0 0.5rem;
  }
  .prose :global(p) {
    margin-block: 0.8rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-block: 0.8rem;
    padding-left: 1.5rem;
  }
  .prose :global(li + li) {
    margin-top: 0.3rem;
  }
  .prose :global(blockquote) {
    margin: 1.25rem 0;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 5px solid var(--ink);
    color: var(--ink-soft);
    font-size: 1rem;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--bg);
    border: 1px solid var(--ink);
    color: var(--ink);
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    margin: 1.25rem 0;
    padding: 0.9rem 1.1rem;
    border: var(--rule);
    border-color: var(--black);
    box-shadow: 4px 4px 0 var(--ink);
    overflow-x: auto;
    line-height: 1.6;
    font-size: 0.85rem;
  }
  .prose :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: var(--rule-thin);
    border-width: 2px;
    padding: 0.45rem 0.7rem;
    text-align: left;
  }
  .prose :global(th) {
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .prose :global(img),
  .prose :global(video) {
    border: var(--rule);
    margin: 1.25rem 0;
  }
  .prose :global(video img) {
    border: none;
    margin: 0;
  }
  .prose :global(a) {
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    font-weight: 500;
  }
  .prose :global(a:hover) {
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
  }
  .prose :global(hr) {
    border: none;
    border-top: var(--rule);
    margin: 2rem 0;
  }
</style>
